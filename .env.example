# Existing one-key configuration remains supported.
AI_PROVIDER=groq
AI_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
OPENAI_API_KEY=
AI_MAX_PACKETS=10
AI_TIMEOUT_SECONDS=60

# Optional shared pool: uncomment this ONE line and replace both placeholder keys.
# Keys from the same organization MUST have the same quota_group.
# Different approved organizations/providers can have separate quota groups;
# do not invent groups to try to bypass an organization's shared limits.
# AI_CREDENTIALS_JSON=[{"label":"Groq primary","provider":"groq","model":"openai/gpt-oss-120b","quota_group":"my-groq-org","key":"PASTE_FIRST_KEY","fallback_enabled":false},{"label":"Groq backup","provider":"groq","model":"openai/gpt-oss-120b","quota_group":"my-groq-org","key":"PASTE_SECOND_KEY","fallback_enabled":false}]

# A different provider/model is used only when that record explicitly enables
# fallback_enabled, authorizing bounded evidence sharing with that destination.
