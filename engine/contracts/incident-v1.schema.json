{
  "$defs": {
    "Edge": {
      "additionalProperties": true,
      "properties": {
        "edge_id": {
          "title": "Edge Id",
          "type": "string"
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Id"
        },
        "target_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Id"
        },
        "source_step_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Step Id"
        },
        "target_step_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Step Id"
        },
        "relationship": {
          "title": "Relationship",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "evidence_strength": {
          "enum": [
            "observed",
            "derived",
            "hypothesized"
          ],
          "title": "Evidence Strength",
          "type": "string"
        }
      },
      "required": [
        "edge_id",
        "relationship",
        "evidence_ids",
        "evidence_strength"
      ],
      "title": "Edge",
      "type": "object"
    },
    "Entity": {
      "additionalProperties": true,
      "properties": {
        "entity_id": {
          "title": "Entity Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "host",
            "account",
            "ip"
          ],
          "title": "Type",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "entity_id",
        "type",
        "label"
      ],
      "title": "Entity",
      "type": "object"
    },
    "Step": {
      "additionalProperties": true,
      "properties": {
        "step_id": {
          "title": "Step Id",
          "type": "string"
        },
        "step_index": {
          "minimum": 1,
          "title": "Step Index",
          "type": "integer"
        },
        "timestamp": {
          "title": "Timestamp",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "technique_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Technique Id"
        },
        "tactic": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Tactic"
        },
        "kill_chain_stage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Kill Chain Stage"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "primary_evidence_id": {
          "title": "Primary Evidence Id",
          "type": "string"
        },
        "evidence_strength": {
          "enum": [
            "observed",
            "derived",
            "hypothesized"
          ],
          "title": "Evidence Strength",
          "type": "string"
        },
        "uncertainty_reason": {
          "title": "Uncertainty Reason",
          "type": "string"
        }
      },
      "required": [
        "step_id",
        "step_index",
        "timestamp",
        "summary",
        "rule_id",
        "technique_id",
        "tactic",
        "kill_chain_stage",
        "evidence_ids",
        "primary_evidence_id",
        "evidence_strength",
        "uncertainty_reason"
      ],
      "title": "Step",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "properties": {
    "contract_version": {
      "const": "1.0",
      "title": "Contract Version",
      "type": "string"
    },
    "incident_id": {
      "title": "Incident Id",
      "type": "string"
    },
    "job_id": {
      "title": "Job Id",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "incident_kind": {
      "enum": [
        "single_finding",
        "related_activity"
      ],
      "title": "Incident Kind",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "entities": {
      "items": {
        "$ref": "#/$defs/Entity"
      },
      "title": "Entities",
      "type": "array"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/Step"
      },
      "title": "Steps",
      "type": "array"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/Edge"
      },
      "title": "Edges",
      "type": "array"
    },
    "steps_truncated": {
      "title": "Steps Truncated",
      "type": "boolean"
    },
    "total_step_count": {
      "minimum": 0,
      "title": "Total Step Count",
      "type": "integer"
    },
    "ai_review": {
      "additionalProperties": true,
      "title": "Ai Review",
      "type": "object"
    }
  },
  "required": [
    "contract_version",
    "incident_id",
    "job_id",
    "revision",
    "incident_kind",
    "title",
    "entities",
    "steps",
    "edges",
    "steps_truncated",
    "total_step_count",
    "ai_review"
  ],
  "title": "IncidentContract",
  "type": "object"
}
