{
  "$defs": {
    "Entity": {
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "title": "Entity Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "host",
            "account",
            "ip",
            "process",
            "file"
          ],
          "title": "Type",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "entity_id",
        "type",
        "label"
      ],
      "title": "Entity",
      "type": "object"
    },
    "Relationship": {
      "additionalProperties": false,
      "properties": {
        "relationship_id": {
          "title": "Relationship Id",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "target_id": {
          "title": "Target Id",
          "type": "string"
        },
        "relationship_type": {
          "title": "Relationship Type",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "interpretation_status": {
          "enum": [
            "observed",
            "derived",
            "hypothesized"
          ],
          "title": "Interpretation Status",
          "type": "string"
        }
      },
      "required": [
        "relationship_id",
        "source_id",
        "target_id",
        "relationship_type",
        "evidence_ids",
        "interpretation_status"
      ],
      "title": "Relationship",
      "type": "object"
    },
    "Step": {
      "additionalProperties": false,
      "properties": {
        "step_id": {
          "title": "Step Id",
          "type": "string"
        },
        "observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observed At"
        },
        "display_order": {
          "title": "Display Order",
          "type": "integer"
        },
        "ordering_basis": {
          "title": "Ordering Basis",
          "type": "string"
        },
        "ordering_confidence": {
          "enum": [
            "high",
            "medium",
            "low",
            "unknown"
          ],
          "title": "Ordering Confidence",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "entity_ids": {
          "items": {
            "type": "string"
          },
          "title": "Entity Ids",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "interpretation_status": {
          "enum": [
            "observed",
            "derived",
            "hypothesized"
          ],
          "title": "Interpretation Status",
          "type": "string"
        },
        "maliciousness": {
          "default": "unknown",
          "enum": [
            "suspicious",
            "malicious",
            "benign",
            "unknown"
          ],
          "title": "Maliciousness",
          "type": "string"
        },
        "technique_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Technique Id"
        },
        "kill_chain_phase": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kill Chain Phase"
        },
        "source_sequence": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Sequence"
        }
      },
      "required": [
        "step_id",
        "observed_at",
        "display_order",
        "ordering_basis",
        "ordering_confidence",
        "summary",
        "entity_ids",
        "evidence_ids",
        "interpretation_status"
      ],
      "title": "Step",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "incident_id": {
      "pattern": "^[A-Za-z0-9_-]{1,120}$",
      "title": "Incident Id",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "severity": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "informational"
      ],
      "title": "Severity",
      "type": "string"
    },
    "risk_score": {
      "maximum": 100,
      "minimum": 0,
      "title": "Risk Score",
      "type": "number"
    },
    "analysis_reference_time": {
      "format": "date-time",
      "title": "Analysis Reference Time",
      "type": "string"
    },
    "entities": {
      "items": {
        "$ref": "#/$defs/Entity"
      },
      "title": "Entities",
      "type": "array"
    },
    "timeline": {
      "items": {
        "$ref": "#/$defs/Step"
      },
      "title": "Timeline",
      "type": "array"
    },
    "relationships": {
      "items": {
        "$ref": "#/$defs/Relationship"
      },
      "title": "Relationships",
      "type": "array"
    },
    "techniques": {
      "items": {
        "additionalProperties": {
          "type": "string"
        },
        "type": "object"
      },
      "title": "Techniques",
      "type": "array"
    },
    "kill_chain": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "items": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "type": "array"
        }
      ],
      "title": "Kill Chain"
    },
    "data_quality_impact": {
      "items": {
        "type": "string"
      },
      "title": "Data Quality Impact",
      "type": "array"
    },
    "engine_review": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Engine Review"
    }
  },
  "required": [
    "incident_id",
    "revision",
    "title",
    "severity",
    "risk_score",
    "analysis_reference_time",
    "entities",
    "timeline",
    "relationships"
  ],
  "title": "Incident",
  "type": "object"
}
