{
  "$defs": {
    "Artifact": {
      "additionalProperties": false,
      "properties": {
        "location": {
          "minLength": 1,
          "title": "Location",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-fA-F0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "size_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Bytes"
        },
        "format": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Format"
        },
        "optional": {
          "default": false,
          "title": "Optional",
          "type": "boolean"
        }
      },
      "required": [
        "location"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "SourceDataset": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "source_size_bytes": {
          "minimum": 0,
          "title": "Source Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "source_size_bytes"
      ],
      "title": "SourceDataset",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "1.0",
      "title": "Contract Version",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9_-]{1,120}$",
      "title": "Run Id",
      "type": "string"
    },
    "source_dataset": {
      "$ref": "#/$defs/SourceDataset"
    },
    "status": {
      "const": "completed",
      "title": "Status",
      "type": "string"
    },
    "incident_count": {
      "minimum": 0,
      "title": "Incident Count",
      "type": "integer"
    },
    "artifacts": {
      "additionalProperties": {
        "$ref": "#/$defs/Artifact"
      },
      "title": "Artifacts",
      "type": "object"
    },
    "engine_status": {
      "default": "completed",
      "enum": [
        "queued",
        "running",
        "completed",
        "failed"
      ],
      "title": "Engine Status",
      "type": "string"
    },
    "engine_phase": {
      "default": "writing_results",
      "enum": [
        "parsing",
        "detecting",
        "correlating",
        "writing_results"
      ],
      "title": "Engine Phase",
      "type": "string"
    }
  },
  "required": [
    "contract_version",
    "run_id",
    "source_dataset",
    "status",
    "incident_count",
    "artifacts"
  ],
  "title": "Manifest",
  "type": "object"
}
