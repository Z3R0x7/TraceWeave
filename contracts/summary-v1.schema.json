{
  "$defs": {
    "Artifact": {
      "additionalProperties": false,
      "properties": {
        "location": {
          "minLength": 1,
          "title": "Location",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-fA-F0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "size_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Bytes"
        },
        "format": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Format"
        },
        "optional": {
          "default": false,
          "title": "Optional",
          "type": "boolean"
        }
      },
      "required": [
        "location"
      ],
      "title": "Artifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "incident_id": {
      "pattern": "^[A-Za-z0-9_-]{1,120}$",
      "title": "Incident Id",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "severity": {
      "title": "Severity",
      "type": "string"
    },
    "risk_score": {
      "maximum": 100,
      "minimum": 0,
      "title": "Risk Score",
      "type": "number"
    },
    "bundle": {
      "$ref": "#/$defs/Artifact"
    }
  },
  "required": [
    "incident_id",
    "revision",
    "title",
    "severity",
    "risk_score",
    "bundle"
  ],
  "title": "Summary",
  "type": "object"
}
